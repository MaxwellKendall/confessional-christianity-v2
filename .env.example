# Algolia — search-only key, safe for the browser. The Admin key is used only
# by the indexing scripts (scripts/) and must never be NEXT_PUBLIC_.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# Supabase — same project as v1; live account/progress data lives here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ESV API — server-side only, used to fetch proof-text scripture for sessions.
ESV_API_KEY=

# Supabase service role — server-only (src/lib/supabaseServiceRole.ts), used by
# POST /api/account/delete to delete auth users. Never NEXT_PUBLIC_, never in the app.
SUPABASE_SERVICE_ROLE_KEY=

# Sign in with Apple token revocation on account deletion (server-only).
# Optional: when unset, /api/account/delete logs a skip and still deletes.
# APPLE_PRIVATE_KEY is the .p8 contents (literal \n escapes are accepted).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

# Lord's Day cards generator (POST /api/lords-day/cards, TKL-861), server-only.
# GEMINI_CARDS_MODEL is optional (default gemini-3.8-flash). The Cognito IDs
# are the stage pool's (infra/: `npm run outputs`); they are not secrets.
GEMINI_API_KEY=
GEMINI_CARDS_MODEL=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Algolia — search-only key, safe for the browser. The Admin key is used only
# by the indexing scripts (scripts/) and must never be NEXT_PUBLIC_.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# Supabase — same project as v1; live account/progress data lives here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ESV API — server-side only, used to fetch proof-text scripture for sessions.
ESV_API_KEY=

# Devotion admin (/admin). Without ADMIN_PASSWORD the admin is open under
# `next dev` and returns 404 everywhere else.
ADMIN_PASSWORD=
# Optional: signs admin session cookies (defaults to ADMIN_PASSWORD, so
# changing the password signs everyone out).
ADMIN_SESSION_SECRET=
# Deployed saves open pull requests. A fine-grained token scoped to this repo
# with Contents + Pull requests read/write. Unset under `next dev` = saves
# write to the working tree instead.
ADMIN_GITHUB_TOKEN=
ADMIN_GITHUB_REPO=MaxwellKendall/confessional-christianity-v2
ADMIN_GITHUB_BASE_BRANCH=main
